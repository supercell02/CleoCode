    "@ai-sdk/provider-utils": "^5.0.43",
    "@clerk/backend": "^3.18.1",
    "@hono/zod-validator": "^0.9.0",
    "@polar-sh/sdk": "^0.49.0",
    "@sentry/bun": "^10.73.0",
    "@sentry/hono": "^10.73.0",
    "ai": "^7.0.93",
    "dotenv": "^17.4.2",
    "hono": "^4.13.4",
    "zod": "^4.4.3"
  }
}
